NEXT_PUBLIC_DEFAULT_SITE_URL=http://localhost:3000

# c15t Configuration
NEXT_PUBLIC_C15T_MODE=
NEXT_PUBLIC_C15T_URL=https://your-instance.c15t.dev

# Databuddy client ID. Unset = Databuddy disabled; Vercel Analytics still runs.
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# Plain label type id (lt_...) for All Things Open giveaway threads. Unset still saves the entry.
# PLAIN_ATO_GIVEAWAY_LABEL_TYPE_ID=

# Homepage hero experiment.
# Unset = 50/50 sticky test. Crawlers get variant B.
# "a" or "b" = send everyone, including crawlers, to that variant. Redeploy after changing it.
# HOMEPAGE_HERO_VARIANT=
#
# Signs the precomputed flag URL. Required on Vercel Production and Preview.
# Generate a distinct value per environment:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# FLAGS_SECRET=